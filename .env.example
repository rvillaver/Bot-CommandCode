# Discord bot token — from the Discord Developer Portal (Bot tab → Reset Token).
# Treat as a secret. Required.
DISCORD_TOKEN=

# Port for the local mod→bot bridge. Must stay bound to 127.0.0.1.
RELAY_PORT=8787

# Comma-separated channel IDs allowed to drive the agent.
# Empty = any DM + any channel the bot can see.
ALLOWED_CHANNEL_IDS=

# Optional "!" prefix mode. Empty = plain messages are prompts.
COMMAND_PREFIX=

# Override for testing (e.g. a wrapper script).
CMD_BINARY=cmd
